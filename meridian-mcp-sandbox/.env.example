# ============================================================================
# MERIDIAN MCP SANDBOX — configuración OPCIONAL
# ============================================================================
# Este archivo es 100% opcional. npm run dev y Startup School funcionan sin él.
# cp .env.example .env
# NUNCA subas un .env real al repositorio.

# Runtime
# MERIDIAN_MODE=live
# MERIDIAN_LOG_LEVEL=info
# MERIDIAN_LOG_FORMAT=json
# MERIDIAN_STACKS=1
# MEMORY_FILE_PATH=./output/memory/meridian-memory.json

# GitHub MCP
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Browser / Playwright
# MERIDIAN_HEADLESS=false
# PLAYWRIGHT_BROWSERS_PATH=
# MERIDIAN_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# MERIDIAN_DEMO_URL=https://example.com

# Media: image
# MERIDIAN_IMAGE_PROVIDER=fal-flux-ultra
# FAL_KEY=
# REPLICATE_API_TOKEN=

# Media: video
# MERIDIAN_VIDEO_PROVIDER=runway-gen3
# RUNWAY_API_KEY=
# RUNWAY_MODEL=gen3a_turbo
# LUMAAI_API_KEY=
# LUMA_MODEL=ray-2

# Observability
# MERIDIAN_WEBHOOK_URL=

# FounderOS — conectores opcionales, solo server-side
# LLM
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# Research / web automation
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
