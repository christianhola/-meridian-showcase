# ============================================================================
# MERIDIAN MCP SANDBOX — configuración OPCIONAL
# ============================================================================
# Este archivo es 100% opcional. `npm run dev`, `npm run test:media` y
# `npm run test:web` funcionan sin él: el sandbox arranca en modo simulación.
#
# Uso:
#   cp .env.example .env      # y descomenta solo lo que necesites
#
# Reglas:
#   - NUNCA subas tu `.env` al repositorio (ya está en .gitignore).
#   - Ninguna variable es obligatoria para arrancar.
# ============================================================================

# ── Runtime (opcional) ──────────────────────────────────────────────────────
# Fuerza modo live cuando existan credenciales: live | simulation
# MERIDIAN_MODE=live
# Nivel de log: debug | info | step | success | warn | error
# MERIDIAN_LOG_LEVEL=info
# Formato de log: pretty (por defecto) | json
# MERIDIAN_LOG_FORMAT=json
# Muestra stack traces en los errores registrados
# MERIDIAN_STACKS=1

# ── MCP (Model Context Protocol) ────────────────────────────────────────────
# Ruta del grafo de conocimiento del servidor oficial de memoria.
# Por defecto: ./output/memory/meridian-memory.json
# MEMORY_FILE_PATH=./output/memory/meridian-memory.json

# Solo necesario para el conector GitHub (`npm run test:tools -- --server=github`)
# GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Automatización web / Playwright ─────────────────────────────────────────
# false => navegador visible (útil para depurar)
# MERIDIAN_HEADLESS=false
# Directorio alternativo de binarios de Chromium
# PLAYWRIGHT_BROWSERS_PATH=
# URL por defecto usada por `npm run test:web`
# MERIDIAN_DEMO_URL=https://example.com

# ── Medios hiperrealistas: IMAGEN ───────────────────────────────────────────
# Proveedor por defecto: fal-flux-ultra | replicate-flux-pro
# MERIDIAN_IMAGE_PROVIDER=fal-flux-ultra
# fal.ai (FLUX 1.1 Pro Ultra) — https://fal.ai/dashboard/keys
# FAL_KEY=
# Replicate (black-forest-labs/flux-1.1-pro) — https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=

# ── Medios hiperrealistas: VÍDEO ────────────────────────────────────────────
# Proveedor por defecto: runway-gen3 | luma-dream-machine
# MERIDIAN_VIDEO_PROVIDER=runway-gen3
# Runway Gen-3 Alpha Turbo — https://dev.runwayml.com
# RUNWAY_API_KEY=
# RUNWAY_MODEL=gen3a_turbo
# Luma Dream Machine / Ray — https://lumalabs.ai/dream-machine/api
# LUMAAI_API_KEY=
# LUMA_MODEL=ray-2

# ── Observabilidad (opcional) ───────────────────────────────────────────────
# Webhook que recibiría el manifiesto de cada generación (nunca se envía nada si está vacío)
# MERIDIAN_WEBHOOK_URL=
