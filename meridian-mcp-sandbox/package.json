{
  "name": "meridian-mcp-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Sandbox independiente de Meridian: Model Context Protocol (MCP), automatización web resiliente con Playwright y generación de medios hiperrealistas. Zero Config / Zero ENV.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "meridian",
    "mcp",
    "model-context-protocol",
    "playwright",
    "automation",
    "flux",
    "runway",
    "hyperrealistic"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "test:web": "tsx src/automation/runner.ts",
    "test:media": "tsx src/media/generator.ts",
    "test:tools": "tsx src/tools/inspector.ts",
    "smoke": "npm run dev && npm run test:media && npm run test:web",
    "setup:browsers": "playwright install chromium",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('output',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-memory": "^1.0.0",
    "@types/node": "^22.18.0"
  }
}
