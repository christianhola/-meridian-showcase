{
  "name": "meridian-community",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "evals": "node scripts/validate-wilenny-evals.mjs",
    "community:check": "node scripts/validate-community-registry.mjs",
    "test": "node --test scripts/*.test.mjs",
    "security:check": "node scripts/audit-public-files.mjs",
    "community:verify": "node scripts/check-github-repositories.mjs",
    "starter:test": "node --test examples/agent-response-starter/test/*.test.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9",
    "typescript": "^5.9.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^1.53.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "vitepress": "^1.6.4"
  }
}
